(version 1)

;; Template: a line tagged ;;!! !FLAG is removed when FLAG is active.
;; Defaults to full access; flags restrict it. Environment variables,
;; resource limits and process execution are not restricted here.

;; TEMPLATE FLAGS
;;
;; Each flag REMOVES the lines tagged with it. Flags only ever
;; subtract, so any combination is safe and order never matters.
;;
;; Filesystem reads
;;   contain-reads       no reading outside cwd, TMP, system and
;;                       tool dirs (/opt/homebrew, /usr/local, ...)
;;   contain-reads-home  as above, with HOME readable too
;;   private             as contain-reads, and tool dirs go too; also
;;                       revokes the blanket XPC lookup system.sb grants
;;
;; Filesystem writes
;;   contain-writes       writes confined to cwd and TMP
;;   contain-writes-home  writes confined to cwd, TMP and HOME
;;   no-writes            nothing is writable, including TMP
;;
;; Network
;;   airgap          no internet; loopback and unix sockets stay
;;   no-loop         no loopback or unix sockets; internet stays
;;
;; Tampering
;;   no-edit-git     no writing to the nearest .git entry from cwd upward
;;   no-edit-m8-st8  no writing to a config directory anywhere
;;
;; A level such as sandbox or jail is a composition of the above, written
;; in an agent's shields.
;;
;; Always allowed, in every mode:
;;   reads of system dirs and the standard /dev nodes; reads of
;;   cwd and TMP; stat of the cwd parent; process exec and fork.
;;
;; Mob scratch under +/ remains writable under every restriction.

;; Pass CWD, PARENTWD, TMP (pre-created scratch), HOME and GIT (nearest .git
;; entry, or an empty string when no entry exists):
;;   sandbox-exec -f resolved.sb \
;;    -D CWD="$(pwd)" \
;;    -D PARENTWD="$(dirname "$(pwd)")" \
;;    -D TMP="$TMPDIR" \
;;    -D HOME="$HOME" \
;;    -D GIT="/resolved/path/to/nearest/.git" \
;;    date

(debug deny)

(deny default)
(import "system.sb")
;; system.sb re-grants blanket XPC lookup to (version 1) profiles as a
;; backward-compat hatch. Deny it here, then re-allow below unless hardened.
(deny mach-lookup (xpc-service-name-prefix ""))
(deny mach-register (local-name-prefix ""))
(allow mach-lookup (xpc-service-name-prefix ""))    ;;!! !private
(allow mach-register (local-name-prefix ""))        ;;!! !private

;; --- process bootstrap ---
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)

;; --- executable essentials ---
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/etc")
  (subpath "/System/Library")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (literal "/private/var/select/sh")
)
(allow file-read* file-write* file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (literal "/dev/stdin")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (regex #"^/dev/fd/[0-9]+$")
  (regex #"^/dev/pty[a-z0-9]+$")
  (regex #"^/dev/tty[a-z0-9]+$")
)

;; --- common executable areas allowed only with softer "contain-reads" ---
(allow file-read*                     ;;!! !private
  (subpath "/opt/homebrew/bin")       ;;!! !private
  (subpath "/opt/homebrew/lib")       ;;!! !private
  (subpath "/opt/homebrew/Cellar")    ;;!! !private
  (subpath "/opt/homebrew/opt")       ;;!! !private
  (subpath "/usr/local/bin")          ;;!! !private
  (subpath "/usr/local/lib")          ;;!! !private
  (subpath "/usr/local/opt")          ;;!! !private
  (subpath "/Library/Frameworks"))    ;;!! !private

(allow file-read* (subpath "/"))      ;;!! !private !contain-reads !contain-reads-home
(allow file-write* (subpath "/"))     ;;!! !contain-writes !contain-writes-home !no-writes

;; --- the real home directory ---
;; The home-aware restrictions leave these narrower allows behind. Every
;; stricter restriction tags them away, so combinations silently take the
;; most restrictive form.
(allow file-read* (subpath (param "HOME")))  ;;!! !private !contain-reads
(allow file-write* (subpath (param "HOME"))) ;;!! !contain-writes !no-writes

;; --- the temp directory ---
(allow file-read*
  file-write*                         ;;!! !no-writes
  (subpath (param "TMP")))

;; --- the current working directory ---
(allow file-read*
  file-write*                         ;;!! !no-writes
  (subpath (param "CWD")))
;; --- stat of cwd parent ---
(allow file-read-metadata
  (literal (param "PARENTWD")))

;; --- tampering ---
;; Remove conditional allows, not denies, so restrictions only subtract.
;; ($|/) covers the directory itself as well as its contents, blocking
;; replacement by rename or symlink as well as writes inside it.
(if (not (string=? (param "GIT") ""))
  (begin
    (deny file-write* (subpath (param "GIT")))
    (allow file-write* (subpath (param "GIT"))) ;;!! !no-edit-git
  ))

(deny file-write* (regex #"(^|/)\.?m8-st8($|/)"))
(allow file-write* (regex #"(^|/)\.?m8-st8($|/)"))      ;;!! !no-edit-m8-st8

(allow file-write* (regex #"(^|/)\.?m8-st8/\+/([^/]+/)*\.tmpdir($|/)"))

;; --- non-local internet access ---
(allow network*)                      ;;!! !airgap

;; --- localhost access ---
(deny network*                        ;; Deny before conditional allow.
  (remote ip "localhost:*")
  (local unix-socket)
  (remote unix-socket))
(allow network*                       ;;!! !no-loop
  (remote ip "localhost:*")           ;;!! !no-loop
  (local unix-socket)                 ;;!! !no-loop
  (remote unix-socket))               ;;!! !no-loop

;; --- name resolution ---
;; Allow mDNSResponder after no-loop's deny so internet DNS still works.
;; airgap removes these exceptions: resolver access is a network channel.
;; Use the socket and named XPC services, not blanket system-socket access.
(allow network-outbound                                     ;;!! !airgap
  (literal "/private/var/run/mDNSResponder"))               ;;!! !airgap
(allow mach-lookup                                          ;;!! !airgap
  (global-name "com.apple.dnssd.service")                   ;;!! !airgap
  (global-name "com.apple.SystemConfiguration.configd"))    ;;!! !airgap

