(version 1)

;; This operates as a template where
;; lines ending in ;;!! !with ... are added
;; UNLESS the associated WITH feature is
;; activated.

;; Note that behavior defaults to full access!
;; Use template flags to restrict.
;; Things not restricted:
;;  - environment variables (inherited in full),
;;  - resource limits,
;;  - process execution.

;; TEMPLATE FLAGS
;;
;; Each flag REMOVES the lines tagged with it. Flags only ever
;; subtract, so any combination is safe and order never matters.
;;
;; Filesystem reads
;;   contain-reads   no reading outside cwd, TMP, system and
;;                   tool dirs (/opt/homebrew, /usr/local, ...)
;;   private         as above, and tool dirs go too; also revokes
;;                   the blanket XPC lookup that system.sb grants
;;
;; Filesystem writes
;;   contain-writes  writes confined to cwd and TMP
;;   no-writes       nothing is writable, including TMP
;;
;; Network
;;   airgap          no internet; loopback and unix sockets stay
;;   no-loop         no loopback or unix sockets; internet stays
;;
;; Tampering
;;   no-edit-git     no writing to a .git anywhere
;;   no-edit-m8-st8  no writing to a config directory anywhere
;;
;; A level such as sandbox or jail is a composition of the above, written
;; in an agent's shields.
;;
;; Always allowed, in every mode:
;;   reads of system dirs and the standard /dev nodes; reads of
;;   cwd and TMP; stat of the cwd parent; process exec and fork.
;;
;; Always denied, in every mode:
;;   writing to core/ in a config directory. That rule carries no
;;   tag, so no combination of flags can subtract it. It is what
;;   makes this file safe to override from config: you may edit
;;   core/ with an editor, since none of this applies to you, but
;;   nothing running under the sandbox can reach it — including a
;;   process trying to widen the profile it is already inside.
;;
;; Always allowed, in every mode, and the pair to that:
;;   writing to a mob's .tmpdir/ under +/ in a config directory. It is the
;;   mob's scratch, which m8 makes before a tool runs and guarantees is
;;   writable. It carries no tag either, so no combination of
;;   flags can take it away.

;; Must be exectuted with parameters.
;; TMPDIR should be pre-created and set inside a safe area like:
;;   private/var/tmp/m8call-UUID
;; Example run command:
;;  sandbox-exec -f resolved.sb \
;;    -D CWD="$(pwd)" \
;;    -D PARENTWD="$(dirname "$(pwd)")" \
;;    -D TMP="$TMPDIR" \
;;    date

(debug deny)

(deny default)
(import "system.sb")
;; system.sb re-grants blanket XPC lookup to (version 1) profiles as a
;; backward-compat hatch. Deny it here, then re-allow below unless hardened.
(deny mach-lookup (xpc-service-name-prefix ""))
(deny mach-register (local-name-prefix ""))
(allow mach-lookup (xpc-service-name-prefix ""))    ;;!! !private
(allow mach-register (local-name-prefix ""))        ;;!! !private

;; --- process bootstrap ---
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)

;; --- executable essentials ---
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/etc")
  (subpath "/System/Library")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (literal "/private/var/select/sh")
)
(allow file-read* file-write* file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (literal "/dev/stdin")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (regex #"^/dev/fd/[0-9]+$")
  (regex #"^/dev/pty[a-z0-9]+$")
  (regex #"^/dev/tty[a-z0-9]+$")
)

;; --- common executable areas allowed only with softer "contain-reads" ---
(allow file-read*                     ;;!! !private
  (subpath "/opt/homebrew/bin")       ;;!! !private
  (subpath "/opt/homebrew/lib")       ;;!! !private
  (subpath "/opt/homebrew/Cellar")    ;;!! !private
  (subpath "/usr/local/bin")          ;;!! !private
  (subpath "/usr/local/lib")          ;;!! !private
  (subpath "/Library/Frameworks"))    ;;!! !private

(allow file-read* (subpath "/"))      ;;!! !private !contain-reads
(allow file-write* (subpath "/"))     ;;!! !contain-writes !no-writes

;; --- the temp directory ---
(allow file-read*
  file-write*                         ;;!! !no-writes
  (subpath (param "TMP")))

;; --- the current working directory ---
(allow file-read*
  file-write*                         ;;!! !no-writes
  (subpath (param "CWD")))
;; --- stat of cwd parent ---
(allow file-read-metadata
  (literal (param "PARENTWD")))

;; --- tampering ---
;; Deny, then allow back conditionally, the same shape as localhost below.
;; A flag removes the allow rather than adding the deny, so flags still only
;; ever subtract and any combination stays safe.
;;
;; The component anchor ($|/) matches the directory itself as well as
;; everything under it, which is what stops the three ways in: creating it,
;; renaming something else onto it, and pointing a symlink at it. Without the
;; $ the directory path never matches, a rename carries a whole subtree past
;; the check, and the contents arrive already inside.
(deny file-write* (regex #"(^|/)\.git($|/)"))
(allow file-write* (regex #"(^|/)\.git($|/)"))          ;;!! !no-edit-git

(deny file-write* (regex #"(^|/)\.?m8-st8($|/)"))
(allow file-write* (regex #"(^|/)\.?m8-st8($|/)"))      ;;!! !no-edit-m8-st8

;; Last, so they win over the allow above, and untagged, so nothing can
;; subtract either. core/ decides what a restriction means, which is what makes
;; this file safe to override from config. A .tmpdir/ is a mob's scratch,
;; which m8 guarantees a tool can write — it holds no definitions, so the one
;; kind of directory always open inside a config directory is the one that
;; says nothing about what runs.
(deny file-write* (regex #"(^|/)\.?m8-st8/core($|/)"))
(allow file-write* (regex #"(^|/)\.?m8-st8/\+/([^/]+/)*\.tmpdir($|/)"))

;; --- non-local internet access ---
(allow network*)                      ;;!! !airgap

;; --- localhost access ---
(deny network*                        ;; Deny before conditional allow.
  (remote ip "localhost:*")
  (local unix-socket)
  (remote unix-socket))
(allow network*                       ;;!! !no-loop
  (remote ip "localhost:*")           ;;!! !no-loop
  (local unix-socket)                 ;;!! !no-loop
  (remote unix-socket))               ;;!! !no-loop

;; --- name resolution ---
;; After the deny above, so it survives no-loop. macOS resolves through
;; mDNSResponder, so no-loop otherwise leaves a tool with the internet allowed
;; and no way to name anything on it.
;;
;; Tagged !airgap: a lookup is a message to a resolver, so a jailed tool with
;; one has a channel out whether or not it can open a connection.
;;
;; Both ways to the resolver are allowed, because which one is taken is the
;; OS version's business: the socket, and the two named XPC services that
;; `private` otherwise revokes. On a macOS wanting the newer spelling, the
;; socket is
;;   (remote unix-socket (path-literal "/private/var/run/mDNSResponder"))
;;
;; Named services rather than (allow system-socket), which is every system
;; socket there is and far past what resolving a name asks for.
(allow network-outbound                                     ;;!! !airgap
  (literal "/private/var/run/mDNSResponder"))               ;;!! !airgap
(allow mach-lookup                                          ;;!! !airgap
  (global-name "com.apple.dnssd.service")                   ;;!! !airgap
  (global-name "com.apple.SystemConfiguration.configd"))    ;;!! !airgap

